# ---------------------------------------------------------------------------
# Metadata providers (Docker)
# TMDB_API_KEY enables /movie, TVDB_API_KEY enables /tv. OMDb is optional.
# ---------------------------------------------------------------------------
TMDB_API_KEY=            # v3 "API Key", not the Read Access Token
TVDB_API_KEY=
TVDB_PIN=                # only if your TVDB key type requires one
OMDB_API_KEY=            # optional
OMDB_DAILY_CAP=900
SUMMARY_LANGUAGE=en-US
LOG_LEVEL=info           # error | warn | info | debug
PORT=3000
DATA_DIR=./data          # SQLite cache
