# ---------------------------------------------------------------------------
# Metadata providers (Docker)
# TMDB_API_KEY enables /movie, TVDB_API_KEY enables /tv. OMDb is optional.
# ---------------------------------------------------------------------------
TMDB_API_KEY=            # v3 "API Key", not the Read Access Token
TVDB_API_KEY=
TVDB_PIN=                # only if your TVDB key type requires one
OMDB_API_KEY=            # optional
OMDB_DAILY_CAP=900
SUMMARY_LANGUAGE=en-US
LOG_LEVEL=info           # error | warn | info | debug
PORT=3000
DATA_DIR=./data          # SQLite cache

# ---------------------------------------------------------------------------
# OPTIONAL: Plex access, only for the command-line tools (npm run cli).
# The providers do NOT need any of this; leave it empty on the Docker host.
#
# WARNING: a Plex token gives full READ/WRITE access to your Plex server
# (the server owner's account). Plex has no read-only tokens. Treat it like a
# password; "Sign out of all devices" in your Plex account revokes it.
# ---------------------------------------------------------------------------
PLEX_URL=                # e.g. http://192.168.1.10:32400
PLEX_TOKEN=              # see README section 6 for how to get it
PLEX_LIBRARIES=          # optional: library names or section IDs
SYNC_WRITE=false         # whole-library writes stay off until true; --item writes always allowed
SYNC_WRITES_PER_SECOND=5
SYNC_CONCURRENCY=4       # source lookups in parallel
