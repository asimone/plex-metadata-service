# Plex server (the machine running Plex Media Server)
PLEX_URL=http://<plex-ip>:32400
# Server owner's token. See README "Getting your Plex token".
PLEX_TOKEN=
# Optional: comma-separated library names or section IDs (default: all movie and TV libraries)
PLEX_LIBRARIES=

# Summary sources
TVDB_API_KEY=
TVDB_PIN=                # only if your TVDB key type requires one
TMDB_API_KEY=            # v3 "API Key", not the Read Access Token
OMDB_API_KEY=            # optional

# error | warn | info | debug
LOG_LEVEL=info

# Sync behaviour
SUMMARY_LANGUAGE=en-US
OMDB_DAILY_CAP=900
SYNC_WRITE=false         # whole-library writes stay off until true; --item writes always allowed
SYNC_WRITES_PER_SECOND=5
SYNC_CONCURRENCY=4       # source lookups in parallel
DATA_DIR=./data          # SQLite state, backups and cache
